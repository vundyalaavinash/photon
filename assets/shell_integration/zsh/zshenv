# photon: Photon's ZDOTDIR shim; sources the user's real .zshenv, never edits it.
# Announce the cwd before anything user-controlled runs, so a slow rc file
# cannot look like "no shell integration" to the terminal.
if [[ -o interactive && $PHOTON_BLOCKS == 1 ]]; then
  __photon_url=${PWD//\%/%25}
  printf '\e]7;file://%s%s\a' "$HOST" "${__photon_url// /%20}"
  unset __photon_url
fi
typeset -g PHOTON_ZDOTDIR=$ZDOTDIR
ZDOTDIR=${PHOTON_USER_ZDOTDIR:-$HOME}
[[ -f $ZDOTDIR/.zshenv ]] && source "$ZDOTDIR/.zshenv"
# The user's .zshenv may relocate ZDOTDIR; later files must come from there.
PHOTON_USER_ZDOTDIR=$ZDOTDIR
if [[ ! -o interactive && ! -o login ]]; then
  # Only zshenv runs here, so nothing would hand ZDOTDIR back; don't let children inherit ours.
  ZDOTDIR=$PHOTON_USER_ZDOTDIR
  unset PHOTON_BLOCKS PHOTON_USER_ZDOTDIR PHOTON_ZDOTDIR
else
  ZDOTDIR=$PHOTON_ZDOTDIR
fi
